# Copie para .env em desenvolvimento local. No Replit, use a aba "Secrets".
# Banco: no Replit, adicione um PostgreSQL (Tools > Database) e o DATABASE_URL aparece sozinho.
# Sem DATABASE_URL o app usa um banco embutido (PGlite) em .data/ — bom para testar, não para produção.
DATABASE_URL=
# Primeiro administrador (opcional). Sem isso, uma senha aleatória é gerada e mostrada no console no primeiro boot.
ADMIN_LOGIN=admin
ADMIN_SENHA=
ADMIN_NOME=Administrador
# Endereço público usado nos links enviados pelo WhatsApp (ex.: https://boasnovas.replit.app). Opcional.
URL_PUBLICA=
# Carrega a escala real de nov/dez 2026 do altar quando o banco estiver vazio (padrão: true).
SEMEAR_DADOS=true
PORT=5000
