    return optional("etiquetas da conversa", [], async () => {
      const linhas = await db.select().from(etiquetas).where(eq(etiquetas.telefone, telefone));
      return linhas.map(l => l.nome);
    });
  }

  // Ação pedida: se falhar, a pessoa fica sabendo.
  async guardarEtiquetas(telefone: string, nomes: string[]): Promise<void> {
    return exigido("guardar etiquetas", async () => {
      await db.delete(etiquetas).where(eq(etiquetas.telefone, telefone));
      if (nomes.length) await db.insert(etiquetas).values(nomes.map(nome => ({ telefone, nome })));
    });
