{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(sudo *)",

      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch *)",
      "Bash(git reflog expire*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :*)",
      "Bash(git remote set-url *)",

      "Bash(*drizzle-kit push*)",
      "Bash(npm run db:push*)",
      "Bash(psql *)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP COLUMN*)",
      "Bash(*TRUNCATE *)",
      "Bash(*DELETE FROM *)",

      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(/verificar.sh)",
      "Edit(**/.git/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rm *)",
      "Bash(npm install*)",
      "Bash(npm uninstall *)",
      "Bash(npx *)",
      "Bash(node -e *)",
      "Bash(node --eval*)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",

      "Edit(/[SISTEMA]-GITHUB/shared/schema.ts)",
      "Edit(/[SISTEMA]-GITHUB/drizzle.config.ts)",
      "Edit(/[SISTEMA]-GITHUB/package.json)",
      "Edit(/[SISTEMA]-GITHUB/package-lock.json)",
      "Edit(/[SISTEMA]-GITHUB/.replit)",
      "Edit(/[SISTEMA]-GITHUB/scripts/**)",
      "Edit(/[SISTEMA]-GITHUB/server/db.ts)",
      "Edit(/[SISTEMA]-GITHUB/server/index.ts)",
      "Edit(/[SISTEMA]-GITHUB/server/auth.ts)",

      "Edit(/[SISTEMA]-GITHUB/shared/dinheiro.ts)",
      "Edit(/[SISTEMA]-GITHUB/server/pagamento.ts)",
      "Edit(/[SISTEMA]-GITHUB/server/fotos.ts)",
      "Edit(/[SISTEMA]-GITHUB/server/rotinas-de-envio.ts)"
    ],
    "allow": [
      "Bash(bash verificar.sh)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(git rebase origin/main)",
      "Bash(git push origin main)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git ls-files *)"
    ]
  }
}
