modules = ["nodejs-22", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", "package-lock.json", "dist", ".data"]

[nix]
channel = "stable-24_11"

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Iniciar"

[[workflows.workflow]]
name = "Iniciar"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
